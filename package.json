{
  "name": "@bugdump/react",
  "version": "0.0.46",
  "description": "Official Bugdump React bindings - a provider, a hook and an error boundary for @bugdump/sdk",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup && node scripts/check-dist.mjs",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit && eslint .",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "bugdump",
    "react",
    "nextjs",
    "bug-reporting",
    "error-boundary",
    "feedback"
  ],
  "author": "Bugdump",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bugdump/bugdump-react"
  },
  "bugs": {
    "url": "https://github.com/bugdump/bugdump-react/issues"
  },
  "homepage": "https://bugdump.com",
  "sideEffects": false,
  "peerDependencies": {
    "@bugdump/sdk": ">=0.0.46 <0.1.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@bugdump/sdk": "0.0.46",
    "@types/react": "^19.2.18",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module"
}
